# Runtime configuration only; nothing here is needed to build the image.
# Optional. Path of the SQLite database file; created on first use.
# Defaults to data/views.db relative to the working directory.
SQLITE_DB_PATH=data/views.db
# Optional. Set a private, rotating value to store a one-way IP hash.
ANALYTICS_IP_HASH_SALT=replace-with-a-random-secret
# Required for the admin area (/admin). Use a long random value (>= 32 chars):
# the session cookie is HMAC-signed with a key derived from this value, so a
# guessable value is offline-crackable, and rotating it signs out all sessions.
ADMIN_KEY=replace-with-a-long-random-secret
# Optional. Timezone used for the admin date range and day buckets.
# Defaults to Asia/Shanghai (fixed offset, no DST).
ADMIN_TZ=Asia/Shanghai
