# Runtime configuration only; nothing here is needed to build the image.
# Optional. Path of the SQLite database file; created on first use.
# Defaults to data/views.db relative to the working directory.
SQLITE_DB_PATH=data/views.db
# Optional. Set a private, rotating value to store a one-way IP hash.
ANALYTICS_IP_HASH_SALT=replace-with-a-random-secret
