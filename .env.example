# Runtime configuration only. Create the database manually before starting the service.
# Do not pass SQL credentials as Docker build args.
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=your-database
AZURE_SQL_USER=your-user
AZURE_SQL_PASSWORD=replace-me
AZURE_SQL_PORT=1433
# Keep false for Azure SQL. Use true only for local SQL Server testing.
AZURE_SQL_TRUST_SERVER_CERTIFICATE=false
# Optional. Set a private, rotating value to store a one-way IP hash.
ANALYTICS_IP_HASH_SALT=replace-with-a-random-secret
